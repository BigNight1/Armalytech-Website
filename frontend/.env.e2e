# Mode-specific env for the Playwright E2E suite (`e2e/`).
#
# Vite loads `.env.e2e` on top of `.env` when started with `--mode e2e`, so this
# file wins over the developer's `BACKEND_URL` (3001, a real `pnpm start:dev`)
# and points the dev-server proxy at the disposable test backend that
# `backend/test/start-e2e-server.ts` boots on 3100.
#
# Do not point this at production: E2E specs create tickets.
BACKEND_URL=http://127.0.0.1:3100

# The public ticket page polls for status changes (`TicketPage.jsx`); 30 s is
# right in production, far too slow for an assertion. Compress it so the E2E
# can prove the "esta página se actualiza sola" promise without waiting.
VITE_TICKET_REFRESH_MS=2000
