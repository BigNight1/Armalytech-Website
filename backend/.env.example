# MongoDB Atlas connection string (or local mongod for dev)
MONGODB_URI=mongodb://127.0.0.1:27017/armalytech

# HTTP port for local dev (main.ts). Vercel ignores this (serverless entry).
PORT=3000

# Node environment: development | production | test
NODE_ENV=development

# Canonical JWT signing secret for the admin session cookie (ADR 0021).
# At least 32 characters, long and random in production (e.g. `openssl rand -base64 48`).
# The app fails fast on startup if it is missing or shorter than 32; there is no fallback.
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars

# DEPRECATED alias of JWT_SECRET, kept only so an existing environment keeps booting.
# It is accepted with the same 32-character minimum, but the app logs a startup warning
# asking you to rename it. Prefer JWT_SECRET; unset this once JWT_SECRET is in place.
SESSION_SECRET=

# Encrypts/decrypts the device key stored on a ticket (`claveEquipo`, AES-256-GCM, ADR 0025).
# Required, at least 32 characters, long and random in production. It has NO fallback and is
# deliberately independent of JWT_SECRET: deriving one from the other would let anyone who
# reads the source decrypt stored device keys. The app fails fast on startup if it is missing.
TICKET_SECRET_KEY=change-me-to-a-different-long-random-string-32-chars

# Admin bootstrap credentials, used only when the `admins` collection is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Session cookie max age, in seconds. Defaults to 12 hours if unset.
SESSION_MAX_AGE_SECONDS=43200

# Number of reverse proxies in front of the app that Express should trust when reading the
# client IP (nginx in Docker, Vercel in production). Defaults to 1 when NODE_ENV=production
# and 0 otherwise (0 = ignore X-Forwarded-For, which is what tests want so a caller cannot
# spoof its IP). Needed for the per-IP throttler (login 5/min) to see the real client
# instead of the proxy address. See SECURITY.md R-04.
TRUST_PROXY_HOPS=0
